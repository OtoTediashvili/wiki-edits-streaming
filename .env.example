# Copy to .env (gitignored) and fill in.

# Required for live streaming. Wikimedia's User-Agent policy asks every client
# for a way to contact its operator: a URL (your GitHub profile works) or email.
WIKISTREAM_CONTACT=

# Optional overrides. Defaults: src/wikistream/config.py (producer) and
# src/wikistream/streaming/settings.py (Spark job).
# WIKISTREAM_LOG_LEVEL=INFO
# WIKISTREAM_CHECKPOINT_SECONDS=5

# Credentials of the local SeaweedFS (S3 + Iceberg catalog). docker-compose.yml
# hands the same values to SeaweedFS and the Spark job. Best set before the
# first `make up`.
# WIKISTREAM_LAKE_ACCESS_KEY=wikistream
# WIKISTREAM_LAKE_SECRET_KEY=wikistream-local-secret
